# Environment variables for local development.
# Copy this file to .env.local and adjust values for your environment.
# .env.local is gitignored. Keep real secrets out of version control.

# PostgreSQL connection string (local dev).
# Format: postgresql://<user>:<password>@localhost:5432/<database>
# Note: .env.local is gitignored; add your real credentials there.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/database-name"
